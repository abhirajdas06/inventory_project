DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
SECRET_KEY=replace-with-a-strong-secret-key

DB_NAME=inventory_db
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5432

# ── Email (SMTP) for the automated daily report ──────────────
# Example uses Gmail with an App Password (recommended). For another provider,
# set EMAIL_HOST / EMAIL_PORT accordingly. If EMAIL_HOST_USER is left blank the
# app falls back to the console backend (prints emails instead of sending).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=InvenTrack Reports <your-sender@gmail.com>
# Who receives the midnight inventory report (comma-separated):
DAILY_REPORT_RECIPIENTS=abhiraj@zacocomputer.com

# For production:
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# SECRET_KEY=generate-a-strong-random-secret
